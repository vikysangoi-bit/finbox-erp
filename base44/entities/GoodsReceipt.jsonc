{
  "name": "GoodsReceipt",
  "type": "object",
  "properties": {
    "receipt_number": {
      "type": "string",
      "description": "Goods receipt number"
    },
    "receipt_date": {
      "type": "string",
      "format": "date"
    },
    "po_id": {
      "type": "string",
      "description": "Purchase order ID"
    },
    "po_number": {
      "type": "string"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "description": "Received items",
      "items": {
        "type": "object",
        "properties": {
          "item_id": {
            "type": "string"
          },
          "item_sku": {
            "type": "string"
          },
          "item_name": {
            "type": "string"
          },
          "ordered_quantity": {
            "type": "number"
          },
          "received_quantity": {
            "type": "number"
          },
          "unit": {
            "type": "string"
          },
          "unit_price": {
            "type": "number"
          },
          "total": {
            "type": "number"
          },
          "warehouse_location": {
            "type": "string"
          },
          "batch_number": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "invoice_number": {
      "type": "string",
      "description": "Supplier's invoice number"
    },
    "invoice_date": {
      "type": "string",
      "format": "date"
    },
    "notes": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "completed",
        "cancelled"
      ],
      "default": "draft"
    },
    "quality_check_status": {
      "type": "string",
      "enum": [
        "pending",
        "passed",
        "failed",
        "partial"
      ],
      "description": "Quality inspection status"
    },
    "received_by": {
      "type": "string"
    },
    "inventory_updated": {
      "type": "boolean",
      "default": false,
      "description": "Whether inventory has been updated"
    },
    "payable_created": {
      "type": "boolean",
      "default": false,
      "description": "Whether accounts payable entry has been created"
    }
  },
  "required": [
    "receipt_date",
    "po_id"
  ]
}
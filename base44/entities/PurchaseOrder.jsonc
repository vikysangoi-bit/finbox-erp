{
  "name": "PurchaseOrder",
  "type": "object",
  "properties": {
    "po_number": {
      "type": "string",
      "description": "Purchase order number"
    },
    "po_date": {
      "type": "string",
      "format": "date"
    },
    "order_form_no": {
      "type": "string",
      "description": "Order form number reference"
    },
    "supplier_id": {
      "type": "string"
    },
    "supplier_code": {
      "type": "string"
    },
    "supplier_name": {
      "type": "string"
    },
    "delivery_date": {
      "type": "string",
      "format": "date",
      "description": "Expected delivery date"
    },
    "delivery_address": {
      "type": "string"
    },
    "ship_to": {
      "type": "string",
      "description": "Ship to location"
    },
    "shipping_address": {
      "type": "string",
      "description": "Shipping address"
    },
    "shipping_terms": {
      "type": "string",
      "enum": [
        "Within India",
        "CIF",
        "FOB"
      ],
      "description": "Shipping terms"
    },
    "payment_terms": {
      "type": "string",
      "enum": [
        "net_7",
        "net_30",
        "net_60",
        "net_90"
      ]
    },
    "currency": {
      "type": "string",
      "default": "USD"
    },
    "exchange_rate": {
      "type": "number",
      "default": 1
    },
    "items": {
      "type": "array",
      "description": "PO line items",
      "items": {
        "type": "object",
        "properties": {
          "itemCode": {
            "type": "string",
            "description": "Item code for mapping"
          },
          "articleNo": {
            "type": "string",
            "description": "EAN / Article number"
          },
          "styleID": {
            "type": "string",
            "description": "Style ID"
          },
          "itemCategory": {
            "type": "string",
            "description": "Item category"
          },
          "description": {
            "type": "string"
          },
          "composition": {
            "type": "string"
          },
          "size": {
            "type": "string"
          },
          "color": {
            "type": "string"
          },
          "hsnCode": {
            "type": "string",
            "description": "HSN code"
          },
          "item_expected_delivery": {
            "type": "string",
            "format": "date"
          },
          "quantity": {
            "type": "number"
          },
          "rate_per_unit": {
            "type": "number"
          },
          "net_before_gst": {
            "type": "number"
          },
          "gst_percentage": {
            "type": "number"
          },
          "gross_value": {
            "type": "number"
          }
        }
      }
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "tax_percentage": {
      "type": "number",
      "default": 0
    },
    "tax_amount": {
      "type": "number",
      "default": 0
    },
    "shipping_cost": {
      "type": "number",
      "default": 0
    },
    "total_amount": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "pending_approval",
        "approved",
        "rejected",
        "partially_received",
        "fully_received",
        "cancelled"
      ],
      "default": "draft"
    },
    "notes": {
      "type": "string"
    },
    "submitted_by": {
      "type": "string"
    },
    "submitted_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "rejection_reason": {
      "type": "string"
    },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          },
          "url": {
            "type": "string"
          }
        }
      }
    }
  },
  "required": [
    "po_date",
    "supplier_id"
  ]
}